<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <h1>Login</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/events">Events</a>
      <a href="/contact">Contact</a>
      <a href="/signup">Sign Up</a>
    </nav>
  </header>

  <main class="container narrow">
    <% if (error) { %>
      <p class="error-message"><%= error %></p>
    <% } %>

    <form class="form needs-validation" action="/login" method="POST" novalidate>
      <label>
        Email
        <input type="email" name="email" required>
      </label>

      <label>
        Password
        <div class="input-group">
          <input type="password" name="password" data-password-input minlength="6" required>
          <button class="button secondary" type="button" data-toggle-password>Show</button>
        </div>
      </label>

      <button class="button" type="submit">Login</button>
    </form>
  </main>

  <footer class="site-footer">
    <p>Event Management System</p>
  </footer>
  <script src="/js/main.js"></script>
</body>
</html>
