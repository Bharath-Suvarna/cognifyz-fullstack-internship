<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Events</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <h1>Events</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/contact">Contact</a>
      <a href="/weather">Weather</a>
      <% if (currentUser && currentUser.role === 'admin') { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/add-event">Add Event</a>
      <% } %>
      <% if (currentUser) { %>
        <form class="nav-logout" action="/logout" method="POST">
          <button type="submit">Logout</button>
        </form>
      <% } else { %>
        <a href="/login">Login</a>
        <a href="/signup">Sign Up</a>
      <% } %>
    </nav>
  </header>

  <main class="container">
    <div class="page-title">
      <h2>All Events</h2>
      <% if (currentUser && currentUser.role === 'admin') { %>
        <a class="button" href="/add-event">Add Event</a>
      <% } %>
    </div>

    <input class="search-input" type="search" placeholder="Search events" data-event-search>

    <div class="event-grid">
      <% if (events.length === 0) { %>
        <p>No events available.</p>
      <% } %>

      <% events.forEach((event) => { %>
        <article class="event-card" data-event-card>
          <h3><%= event.title %></h3>
          <p><strong>Date:</strong> <%= event.date.toDateString() %></p>
          <p><strong>Location:</strong> <%= event.location %></p>
          <p><%= event.description %></p>
          <div class="actions">
            <% if (!currentUser || currentUser.role === 'user') { %>
              <a class="button" href="/register/<%= event._id %>">Register</a>
            <% } %>
            <% if (currentUser && currentUser.role === 'admin') { %>
              <a class="button secondary" href="/edit-event/<%= event._id %>">Edit</a>
              <form action="/delete-event/<%= event._id %>" method="POST">
                <button class="button danger" type="submit">Delete</button>
              </form>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </main>

  <footer class="site-footer">
    <p>Event Management System</p>
  </footer>
  <script src="/js/main.js"></script>
</body>
</html>
