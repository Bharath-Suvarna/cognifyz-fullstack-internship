<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Event Management System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <h1>Event Management System</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/events">Events</a>
      <a href="/contact">Contact</a>
      <a href="/weather">Weather</a>
      <% if (currentUser && currentUser.role === 'admin') { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/add-event">Add Event</a>
      <% } %>
      <% if (currentUser) { %>
        <form class="nav-logout" action="/logout" method="POST">
          <button type="submit">Logout</button>
        </form>
      <% } else { %>
        <a href="/login">Login</a>
        <a href="/signup">Sign Up</a>
      <% } %>
    </nav>
  </header>

  <main class="container">
    <section class="hero">
      <h2>Run Every Event From <span>One Powerful Platform</span></h2>
      <p>Plan, publish, manage, and register participants with a smooth event booking experience.</p>
      <a class="button" href="/events">View Events</a>
    </section>

    <section>
      <h2>Upcoming Events</h2>
      <input class="search-input" type="search" placeholder="Search events" data-event-search>

      <div class="event-grid">
        <% if (events.length === 0) { %>
          <p>No events available.</p>
        <% } %>

        <% events.forEach((event) => { %>
          <article class="event-card" data-event-card>
            <h3><%= event.title %></h3>
            <p><%= event.description %></p>
            <p><strong>Date:</strong> <%= event.date.toDateString() %></p>
            <p><strong>Location:</strong> <%= event.location %></p>
            <% if (!currentUser || currentUser.role === 'user') { %>
              <a class="button" href="/register/<%= event._id %>">Register</a>
            <% } %>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="api-preview">
      <h2>Recent Events</h2>
      <ul data-api-events>
        <li>Loading events...</li>
      </ul>
    </section>
  </main>

  <footer class="site-footer">
    <p>Event Management System</p>
  </footer>
  <script src="/js/main.js"></script>
</body>
</html>
