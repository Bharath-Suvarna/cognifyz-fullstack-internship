<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Event Weather</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <h1>Event Weather</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/events">Events</a>
      <a href="/contact">Contact</a>
    </nav>
  </header>

  <main class="container">
    <% if (error) { %>
      <p class="error-message"><%= error %></p>
    <% } %>

    <% if (!error && weatherReports.length === 0) { %>
      <p>No events available for weather reports.</p>
    <% } %>

    <section class="event-grid">
      <% weatherReports.forEach((report) => { %>
        <article class="event-card">
          <h3><%= report.event.title %></h3>
          <p><strong>Event Date:</strong> <%= report.event.date.toDateString() %></p>
          <p><strong>Event Location:</strong> <%= report.event.location %></p>
          <p><strong>Weather Location:</strong> <%= report.locationName %></p>

          <% if (report.weather) { %>
            <p><strong>Temperature:</strong> <%= report.weather.temperature %>&deg;C</p>
            <p><strong>Wind Speed:</strong> <%= report.weather.windspeed %> km/h</p>
            <p><strong>Wind Direction:</strong> <%= report.weather.winddirection %>&deg;</p>
          <% } else { %>
            <p class="error-message"><%= report.error %></p>
          <% } %>
        </article>
      <% }) %>
    </section>
  </main>

  <footer class="site-footer">
    <p>Event Management System</p>
  </footer>
</body>
</html>
