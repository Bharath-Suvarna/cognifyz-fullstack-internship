<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <h1>Register</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/events">Events</a>
      <form class="nav-logout" action="/logout" method="POST">
        <button type="submit">Logout</button>
      </form>
    </nav>
  </header>

  <main class="container narrow">
    <section class="event-summary">
      <h2><%= event.title %></h2>
      <p><%= event.description %></p>
      <p><strong>Date:</strong> <%= event.date.toDateString() %></p>
      <p><strong>Location:</strong> <%= event.location %></p>
    </section>

    <% if (success) { %>
      <p class="success-message">Registration successful</p>
    <% } %>

    <% if (error) { %>
      <p class="error-message"><%= error %></p>
    <% } %>

    <form class="form needs-validation" action="/register/<%= event._id %>" method="POST" novalidate>
      <label>
        Name
        <input type="text" value="<%= currentUser.name %>" readonly>
      </label>

      <label>
        Email
        <input type="email" value="<%= currentUser.email %>" readonly>
      </label>

      <label>
        Phone
        <input type="tel" name="phone" required>
      </label>

      <button class="button" type="submit">Register</button>
    </form>
  </main>

  <footer class="site-footer">
    <p>Event Management System</p>
  </footer>
  <script src="/js/main.js"></script>
</body>
</html>
