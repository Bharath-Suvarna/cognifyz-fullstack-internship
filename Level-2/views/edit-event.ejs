<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Event</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <h1>Edit Event</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/events">Events</a>
      <form class="nav-logout" action="/logout" method="POST">
        <button type="submit">Logout</button>
      </form>
    </nav>
  </header>

  <main class="container narrow">
    <form class="form needs-validation" action="/edit-event/<%= event._id %>" method="POST" novalidate>
      <label>
        Title
        <input type="text" name="title" value="<%= event.title %>" required>
      </label>

      <label>
        Date
        <input type="date" name="date" value="<%= event.date.toISOString().slice(0, 10) %>" required>
      </label>

      <label>
        Location
        <input type="text" name="location" value="<%= event.location %>" required>
      </label>

      <label>
        Description
        <textarea name="description" rows="5" required><%= event.description %></textarea>
      </label>

      <button class="button" type="submit">Update Event</button>
    </form>
  </main>

  <footer class="site-footer">
    <p>Event Management System</p>
  </footer>
  <script src="/js/main.js"></script>
</body>
</html>
