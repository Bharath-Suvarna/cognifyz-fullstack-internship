<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <h1>Admin Dashboard</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/events">Events</a>
      <a href="/add-event">Add Event</a>
      <form class="nav-logout" action="/logout" method="POST">
        <button type="submit">Logout</button>
      </form>
    </nav>
  </header>

  <main class="container">
    <section class="dashboard-grid">
      <article class="event-card">
        <h3>Total Events</h3>
        <p class="stat-number"><%= eventCount %></p>
      </article>
      <article class="event-card">
        <h3>Registrations</h3>
        <p class="stat-number"><%= registrationCount %></p>
      </article>
      <article class="event-card">
        <h3>Users</h3>
        <p class="stat-number"><%= userCount %></p>
      </article>
    </section>

    <section class="api-preview">
      <h2>Recent Events</h2>
      <ul>
        <% if (recentEvents.length === 0) { %>
          <li>No events created yet.</li>
        <% } %>
        <% recentEvents.forEach((event) => { %>
          <li><%= event.title %> - <%= event.date.toDateString() %></li>
        <% }) %>
      </ul>
    </section>
  </main>

  <footer class="site-footer">
    <p>Event Management System</p>
  </footer>
</body>
</html>
